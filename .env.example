# =============================================================================
# Totem WhatsApp Reminder Bot — plantilla de configuración
# Copiar a .env y completar. NUNCA commitear .env ni valores reales.
# Todas las variables se validan con Zod al arrancar (src/config/env.ts).
# =============================================================================

# --- Aplicación --------------------------------------------------------------
NODE_ENV=development                  # development | test | production
APP_TIME_ZONE=America/Guayaquil       # zona horaria de negocio (IANA). NO es la del servidor
LOG_LEVEL=debug                       # trace|debug|info|warn|error|fatal (producción: info)

# --- HTTP (solo health checks) -----------------------------------------------
HTTP_HOST=127.0.0.1                   # nunca 0.0.0.0 sin una razón documentada
HTTP_PORT=3000

# --- Base de datos -----------------------------------------------------------
# Desarrollo (docker compose up -d postgres)
DATABASE_URL=postgresql://totem:totem@localhost:5432/totem_bot?schema=public
# Pruebas de integración: el nombre DEBE terminar en _test o la suite aborta
# DATABASE_URL=postgresql://totem:totem@localhost:5433/totem_bot_test?schema=public

# --- WhatsApp ----------------------------------------------------------------
# INTERRUPTORES DE SEGURIDAD. Los valores por defecto NO envían nada.
# El adaptador real solo se construye si ENABLED=true Y DRY_RUN=false.
# Cambiarlos es una acción OWNER_REQUIRED (ver OPERATIONS.md).
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=true
# Directorio de la sesión de Baileys. FUERA del repositorio. Permisos 0700.
# Producción sugerida: /var/lib/totem-bot/wa-auth
WHATSAPP_AUTH_DIRECTORY=./.local/wa-auth
WHATSAPP_SEND_MIN_DELAY_MS=3000       # pausa mínima entre envíos
WHATSAPP_SEND_MAX_DELAY_MS=8000       # pausa máxima entre envíos
WHATSAPP_RECONNECT_MAX_ATTEMPTS=10

# --- Worker ------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=120
WORKER_BATCH_SIZE=25

# --- Motor de recordatorios --------------------------------------------------
REMINDER_DEFAULT_MAX_ATTEMPTS=3
REMINDER_LOCK_TIMEOUT_SECONDS=300     # tras esto, un recordatorio reclamado se recupera
REMINDER_RETRY_BASE_SECONDS=60        # backoff exponencial con jitter
REMINDER_RETRY_MAX_SECONDS=3600
REMINDER_STALE_AFTER_HOURS=12         # más viejo que esto -> CANCELLED(STALE)
DRY_RUN_MARK_SENT=false               # en dry-run, ¿marcar como enviado? (permite repetir ensayos)

# --- Retención (PRI-04) ------------------------------------------------------
RETENTION_MONTHS=12                   # antigüedad máxima de MessageAttempt y AuditEvent
RETENTION_PURGE_INTERVAL_HOURS=24     # cada cuánto corre la purga en el worker

# --- Ventana horaria de negocio ----------------------------------------------
# Valores por defecto; AutomationSetting en la base los puede sobrescribir
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:30
BUSINESS_SEND_ON_SUNDAYS=false

# --- Offsets por defecto de los recordatorios --------------------------------
RECORDING_REMINDER_OFFSET_HOURS=24
TASK_REVIEW_REMINDER_OFFSET_HOURS=48
TASK_REVIEW_MAX_REMINDERS=2
INVOICE_REMINDER_OFFSETS_DAYS=-3,0,3,7   # negativo = antes del vencimiento
INVOICE_MAX_REMINDERS=4
